APP_NAME=Nimtech
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nimtech.co.ke
CANONICAL_HOST=nimtech.co.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@nimtech.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AUTHORITY_STRICT_SLUG_BINDING=true
AUTHORITY_PHONE_CATEGORY_SLUGS=phones,mobile-phones,smartphones
AUTHORITY_LAPTOP_CATEGORY_SLUGS=laptops,laptop-computers,notebooks
AUTHORITY_BRAND_IPHONE_SLUGS=apple,iphone
AUTHORITY_BRAND_SAMSUNG_SLUGS=samsung
AUTHORITY_BRAND_HP_SLUGS=hp,hewlett-packard
AUTHORITY_BRAND_DELL_SLUGS=dell
AUTHORITY_BRAND_LENOVO_SLUGS=lenovo
AUTHORITY_BRAND_XIAOMI_SLUGS=xiaomi,redmi,poco
